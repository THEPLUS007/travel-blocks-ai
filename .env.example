NODE_ENV=production
API_PORT=3000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE_NAME
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACES_TIMEOUT_MS=10000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_INTENT_MODEL=
GEMINI_TIMEOUT_MS=15000
GEMINI_INTENT_TIMEOUT_MS=30000
GEMINI_LONG_TASK_TIMEOUT_MS=40000
GEMINI_LONG_TASK_RETRY_BUDGET_MS=45000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENCY=1
SELF_HOSTED_LLM_ENABLED=false
SELF_HOSTED_LLM_ENDPOINT=
SELF_HOSTED_LLM_MODEL=
SELF_HOSTED_LLM_API_TOKEN=
SELF_HOSTED_LLM_TIMEOUT_MS=15000
AI_ROUTING_MODE=gemini_only
SELF_HOSTED_LLM_READINESS=unknown
COOKIE_SECURE=true
TRUST_PROXY=true
WEB_ORIGIN=https://YOUR_DOMAIN
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
